# Copy to .env.local — never commit secrets
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Public client key from Supabase (Dashboard → Project Settings → API → API Keys):
# - Legacy: "anon" / "public" JWT (starts with eyJ) under Legacy API Keys, or
# - New: Publishable key (starts with sb_publishable_) — same role as anon on hosted projects.
# Never put secret / service_role keys in NEXT_PUBLIC_* vars.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key_here
# Optional: for server-only scripts (not bundled to client)
SUPABASE_SERVICE_ROLE_KEY=

# Canonical origin of the app (no trailing slash). Used by getPublicEnv() for signup resend,
# password reset redirects, etc. Must match Supabase Auth redirect allowlist: {this value}/auth/callback
# In production, set to your real https:// domain — not localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000
