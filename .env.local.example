# Copy to .env.local — never commit secrets
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Must be the "anon" / "public" JWT from Supabase (Dashboard → Project Settings → API → Project API keys).
# It looks like eyJhbGciOiJIUzI1NiIsInR5cCI6... — NOT the Vite-style or sb_publishable_* key unless your SDK docs say so.
# Wrong key → 400 on /auth/v1/token (password grant) in the browser console.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_jwt_here
# Optional: for server-only scripts (not bundled to client)
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL (password reset emails, share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
